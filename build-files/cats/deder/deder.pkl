amends "https://sake92.github.io/deder/config/v0.19.5/DederProject.pkl"

local const basePomSettings = new PomSettings {
  groupId = "org.typelevel"
  description = "cats"
}

local const kernel =
  new CreateScalaModules {
    root = "kernel"
    id = "kernel"
    layout = "sbt"
    template = new ScalaModule {
      scalaVersion = "3.3.7"
      scalacOptions {
        "-Ykind-projector"
        "-source:3.0-migration"
      }
      sources { "target/scala-3.3.7/src_managed/main" }
      deps {
        "org.typelevel::scalac-compat-annotation:0.1.4"
      }
      pomSettings = (basePomSettings) {
        artifactId = "cats-kernel"
        version = "0.0.0-BENCH"
      }
    }
    testTemplate = (template.asTest()) {
      scalaVersion = "3.3.7"

      deps {
        "org.scalameta::munit:1.3.0"
        "org.typelevel::discipline-munit:2.0.0"
      }
    }
  }.get

